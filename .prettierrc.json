{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["*.md", "*.markdown", "*.yml", "*.yaml", "*.json", "*.jsonc"],
      "options": { "singleQuote": false }
    }
  ]
}
